# Agentworks config — GENERATED. Do not edit this file directly: it is rendered
# by provision/operator-config.sh (via `op inject`) from
# provision/agentworks-config.toml.tmpl in the dotfiles repo. To change it, edit
# the template and re-run operator-config.sh. The [proxmox] values come from
# 1Password (the homelab item's proxmox-* fields); everything else is literal.
#
# Operator-workstation only — this is NOT part of the chezmoi-managed home/ tree,
# so `chezmoi apply` on a VM never renders it.

# --- Operator identity (that's me, driving agentworks from my Mac) ----------
[operator]
ssh_public_key  = "~/.ssh/id_ed25519.pub"   # authorizes me onto the VMs
ssh_private_key = "~/.ssh/id_ed25519"        # used for SSH to the VMs

# --- Default platform -------------------------------------------------------
[defaults]
platform = "proxmox"

# --- Secret framework -------------------------------------------------------
# Two backends, tried in order: read from env first, prompt if missing.
# The env vars themselves get populated from 1Password (op read) in my shell.
[secret_backends.env-var]
[secret_backends.prompt]

[secret_config]
backends = ["env-var", "prompt"]

# The only secret the VM layer needs: the Tailscale auth key used to join each
# new VM to the tailnet. env-var convention → AW_SECRET_TAILSCALE_AUTH_KEY.
[secrets.tailscale-auth-key]
description = "Tailscale auth key for joining agentworks VMs to the tailnet"
hint = "1Password: op read the tailscale auth key into AW_SECRET_TAILSCALE_AUTH_KEY"

# --- Proxmox homelab --------------------------------------------------------
# Infra identifiers, injected from 1Password's homelab item (proxmox-* fields) so
# nothing homelab-identifying lands in the public repo. The API *token secret* is
# NOT here — it comes from the PROXMOX_TOKEN_SECRET env var (also from 1Password).
[proxmox]
api_url       = "{{ op://Private/homelab/proxmox-api-url }}"
node          = "{{ op://Private/homelab/proxmox-node }}"
token_id      = "{{ op://Private/homelab/proxmox-token-id }}"
template_vmid = {{ op://Private/homelab/proxmox-template-vmid }}   # sanitized (no baked-in tailscale state / machine-id)
storage       = "{{ op://Private/homelab/proxmox-storage }}"
bridge        = "{{ op://Private/homelab/proxmox-bridge }}"
pool          = "{{ op://Private/homelab/proxmox-pool }}"

# --- VM template: the capability ceiling ------------------------------------
# Hardware + the tailscale key + the apt tools. The apt list is pre-installed
# HERE (agentworks gives it a 300s window) rather than left to bootstrap.sh's
# 120s dotfiles step, where the full apt install (esp. qemu) blew the timeout.
# debian.sh installs the SAME set standalone for bare-metal; the two are kept in
# sync by provision/check-apt-drift.py. qemu is deliberately absent — it's heavy
# and unneeded on these VMs (debian.sh installs it only when SKIP_HEAVY!=1).
[vm_templates.default]
cpus   = 4
memory = 8    # GiB
disk   = 50   # GiB
tailscale_auth_key = "tailscale-auth-key"
# Mirrors debian.sh's APT_PACKAGES exactly (drift-guarded). Plain apt names.
apt = [
  "zsh", "tmux", "tmuxinator",
  "ripgrep", "fzf", "entr", "cloc", "shellcheck", "luarocks",
  "htop", "procps", "wget", "pwgen", "nmap",
  "git", "curl", "gh", "jq", "ca-certificates", "xz-utils",
]

# --- Admin user: hand off toolchain + config to my bootstrap ----------------
# No user_install_commands, no mise, no shell here — bootstrap.sh owns all of
# that (incl. chsh to zsh). agentworks clones my (public) dotfiles to ~/.dotfiles
# and runs bootstrap.sh as the last init step. git_credentials deferred to the
# workspace layer (the dotfiles repo is public, so cloning it needs none).
#
# AGW_BOOTSTRAP=1 confirms the Layer-1 (system) run: bootstrap.sh refuses an
# unattended system provisioning without it, so a mis-fired reinit can't clobber
# an established box. SKIP_HEAVY=1 tells debian.sh to skip qemu (bare-metal-only,
# ~2min) so it can't blow the 120s window. The apt tools are already in via
# vm_template.apt above, so debian.sh's remaining work is just the vendor
# binaries (chezmoi/rust/zig/nvim/jj/tailscale) + chezmoi apply — fits 120s.
# Still re-runnable: a timeout settles fast on reinit (all steps idempotent).
[admin.config]
username = "agentworks"
git_force_safe_directory = true
# claude + oh-my-zsh come from agentworks's builtin user_install_commands
# catalog — installed per-user BEFORE the dotfiles step, so debian.sh's own
# (guarded) installs of them no-op on the VM. Moving them out of the 120s window
# buys headroom. debian.sh still installs them standalone for bare-metal.
user_install_commands = ["claude", "oh-my-zsh"]
dotfiles_source      = "git::https://github.com/n2p5/dotfiles"
dotfiles_destination = "~/.dotfiles"
dotfiles_install_cmd = "AGW_BOOTSTRAP=1 SKIP_HEAVY=1 ./bootstrap.sh"
