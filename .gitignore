# macOS / OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editor swap & backup files
*~
*.swp
*.swo
.idea/
.vscode/

# Per-user, never committed
.claude/settings.local.json
.env
.env.local

# Local working notes / scratch — planning docs, spikes, throwaway files.
# Lives in-repo for convenience but is never committed.
scratch/

# Literal "$XDG_CONFIG_HOME" dir created when a tool runs with the
# variable unexpanded (nvim writes its pack lock file there).
$XDG_CONFIG_HOME/
